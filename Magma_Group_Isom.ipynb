   "source": [
    "G1 = magma('FPGroup <m,l,t | t^-1*m*t=m*l, t^-1*l*t = l*m>')\n",
    "G2 = magma('FPGroup <x,y | x^-1*y*x*y^-1*x = y*x^-1*y*x*y^-1>')\n",
    "\n",
    "magma(f'SearchForIsomorphism({G1.name()},{G2.name()},10)')\n",
    "\n",
    "\n"
